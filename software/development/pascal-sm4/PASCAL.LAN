        2.4. obra}enie k absol`tnym adresam pamqti

       w otdelxnyh slu~aqh bywaet udobno imetx  wozmovnostx
  obra}atxsq  k  absol`tnym  q~ejkam  pamqti,  naprimer,  k
  registram wne{nih  ustrojstw  ili  tablicam  operacionnoj
  sistemy.  dlq   |toj   celi   w   paskalx/rafos   sleduet
  ispolxzowatx   kl`~ewoe   slowo   ORIGIN   w   ob'qwlenii
  peremennoj. naprimer, sledu`}aq programma s~itywaet  znak
  s klawiatury sistemnogo terminala na fizi~eskom urowne:

         CONST   READY   =200B;
         VAR     KBCSR ORIGIN 177560B,
                 KBDAT ORIGIN 177562:    INTEGER;
                 CH:CHAR;
         BEGIN
                 WHILE (KBCSR AND READY) = 0 DO ;(*vdatx*)
                 C := CHR(KBDAt);
         END.

        2.5. adresnyj operator "@"

       w  sostaw   qzyka   paskalx/rafos   whodit   unarnyj
  operator,  obozna~aemyj  "@".  esli  ego  ispolxzowatx  s
  peremennoj tipa "A", to rezulxtatom budet  zna~enie  tipa
  "^A"  (ukazatelx  na  "A").   adresnaq   operaciq   movet
  ispolxzowatxsq  dlq  raboty  so  spiskowymi   strukturami
  dannyh ili dlq pereda~i adresow w  programmy,  napisannye
  na qzyke makroassembler. naprimer:

         TYPE    BLOCK=ARRAY[0..511] OF CHAR;
         VAR     BUFFER:BLOCK;
         BEGIN
                 (* zapomnitx adres bufera *)
                 XRB.XRLOC:=@BUFFER
         END;

        2.6. ispolxzowanie makroassemblera

       paskalx/rafos  daet  wozmovnostx  wkl`~atx  w  l`boe
  mesto   programmy   otdelxnye    fragmenty    na    qzyke
  makroassembler.   ~asti    programmy,    napisannye    na
  makroassemblere,   mogut   ispolxzowatx   peremennye   iz
  programmy na qzyke  paskalx,  hotq  dlq  |togo  trebuetsq
  nekotoroe ponimanie processa organizacii wypolneniq.  dlq
  wkl`~eniq   fragmenta    na    assemblere    ispolxzuetsq
  specialxnyj wid kommentariew, naprimer:


         PROCEDURE EMTTRAP (N:INTEGER);
         BEGIN
           (*$C                  ;na~alo fragmenta na makro
                 MOV N(SP),-(SP) ;parametr "N" -> w stek
                 EMT 53          ;wyzwatx dispet~er EMT
           *)
         END     (* EMTTRAP*)

       pri ispolxzowanii makroassemblera  sleduet  pomnitx,
  ~to osnowaniem s~isleniq ~islowyh konstant  po  umol~ani`
  qwlqetsq 10, a ne 8.

                 3. operatory wwoda/wywoda

        3.1. dopolnitelxnye  argumenty  dlq  "RESET"   i
             "REWRITE"

       w  paskalx/rafos  ras{ireny  standartnye   procedury
  "RESET" i "REWRITE" tremq dopolnitelxnymi neobqzatelxnymi
  parametrami  dlq   ukazaniq   swqzi   mevdu   wnutrennimi
  fajlowymi peremennymi i fajlami na wne{nih ustrojstwah

  PROSEDURE RESET(F:FILE;NAME,DEFEXT:STRING;
                  VAR LEN:INTEGER)

       procedura  RESET  swqzywaet  fajlowu`  peremennu`  s
  su}estwu`}im  wne{nim  fajlom,  a   takve   ustanawliwaet
  ukazatelx fajla na perwyj |lement  (zapisx).  "F"  wsegda
  dolvna prisutstwowatx i  bytx  fajlowoj  peremennoj.  imq
  fajla "NAME" i ras{irenie imeni fajla  dolvny  imetx  tip
  "ARRAY OF CHAR".

       imq fajla dolvno sootwetstwowatx prinqtomu  w  rafos
  standartnomu obozna~eni` i movet  wkl`~atx  imq  i  nomer
  ustrojstwa, a takve tip fajla.  tip  fajla  po  umol~ani`
  budet ispolxzowatxsq tolxko w tom slu~ae, esli wo  wtorom
  parametre  otsutstwuet  tip  fajla.  esli  |tot  parametr
  nuven, to budet ispolxzowan tip "DAT".

       peremennaq  "LEN"  polu~it  zna~enie,  rawnoe  ~islu
  blokow po 512 bajt w  fajle,  libo  -  1,  esli  fajl  ne
  najden.  sleduet  u~estx,  ~to  esli  |tot  parametr   ne
  ispolxzowan, to otsutstwie  fajla  priwedet  k  fatalxnoj
  o{ibke programmy.

  PROCEDURE REWRITE(F:FILE; NAME,DEFEXT:STRING;
                    VAR LEN:INTEGER)

       procedura "REWRITE" sozdaet nowyj  fajl  na  wne{nem
  ustrojstwe. parametry  "NAME"  i  "DEFEXT"  ime`t  to  ve
  zna~enie (smysl), ~to i dlq procedury  "RESET".  parametr
  "LEN" ukazywaet razmer sozdawaemogo fajla w blokah po 512
  bajt.

       primer:

         VAR NAME: ARRAY[1..20] OF CHAR;
             INF,OUTF: TEXT;
             (* opredeleno w sisteme kak "FILE OF CHAR *)
             LEN: INTEGER;
         BEGIN
             (* swqzatx OUTF s ustrojstwom pe~ati *)
             REWRITE(OUTF,'LP:');
             REPEAT
                 WRITE('FILENAME: ');
                 (* zaprositx imq fajla s terminala *)
                 READLN(NAME);
                 (*swqzatx INF s su}estwu`}im fajlom *)
                 RESET(INF,NAME,'PAS',LEN)
             (* powtorqtx poka fajl ne budet otkryt *)
             UNTIL LEN<>-1;
         END.

        3.2. procedura "BREAK"

       dlq  celej  |ffektiwnosti  paskalx/rafos  buferizuet
  dannye, peredawaemye w fajl. procedura  "BREAK"  wyzywaet
  nemedlennyj wywod wozmovno e}e nepolnogo bufera (bloka) w
  fajl. |to nado  ispolxzowatx  pri  rabote  s  terminalom,
  naprimer, dlq wywoda podskazki ili soob}eniq.

       sleduet otmetitx, ~to  paskalx/rafos  ne  buferizuet
  rabotu s drajwerami, o kotoryh izwestno, ~to oni qwlq`tsq
  "interaktiwnymi", naprimer, wyhodnoj  fajl  po  umol~ani`
  (OUTPUT).

       primer:

         VAR F:TEXT;
         BEGIN
           REWRITE(F,'TT:');
           WRITELN(F,'wwedite komandnu` stroku');
           BREAK(F);    (* wywesti dannye na tt: *)
         END.

        3.3. procedura "CLOSE"

       wyzow procedury "CLOSE" wsegda dolven osu}estwlqtxsq
  posle zawer{eniq raboty programmy s fajlom. |ta procedura
  peresylaet na wne{nee ustrojstwo ne do konca  zapolnennyj
  bufer, ustranqet swqzx s  wne{nim  fajlom  i  oswobovdaet
  bufernu` pamqtx dlq  ispolxzowaniq  ee  w  drugih  celqh.
  procedury "RESET"  ili  "REWRITE"  dolvny  pred{estwowatx
  wsqkoj rabote s fajlowoj peremennoj.

       p_r_i_m_e_~_a_n_i_e. prcedurA "CLOSE" wsegda  dolvna
  ispolxzowatxsq  w  konce  raboty  s   fajlom,   sozdannym
  programmoj (wyhodnym fajlom). zakrywanie fajlow dlq wwoda
  ne  qwlqetsq  obqzatelxnym,   no   pozwolqet   oswoboditx
  bufernu` pamqtx.

       primer:

         CLOSE(F)

        3.4. ~tenie simwolxnyh massiwow

       wozmovnosti  standartnoj  procedury  ras{iriny   dlq
  obespe~eniq raboty  s  simwolxnymi  massiwami  peremennoj
  dliny.  znaki  budut  s~itywatxsq,  na~inaq  s   teku}ego
  poloveniq ukazatelq w fajle, poka ne  wstretitsq  probel,
  zapqtaq ili konec stroki. pri |tom stroka budet wyrawnena
  slewa i dopolnena probelami (esli stroka menx{e massiwa),
  ili use~ena sprawa (esli stroka bolx{e massiwa).

        3.5. wosxmeri~nyj wywod s pomo}x` "WRITE"

       procedura  "WRITE"  budet  wywoditx  celye  ~isla  w
  wosxmeri~nom wide,  esli  wyravenie  dlq  formata  wywoda
  budet otricatelxnym, naprimer:

         (* wywesti "I" w wosxm.wide - 5 znakow *)
         WRITE(I:-5);

       3.6. fajly prqmogo dostupa

       paskalx/rafos   sodervit    neskolxko    opredelenij
  procedur, kotorye posle translqcii  wmeste  s  programmoj
  obespe~iwa`t   prqmoj   dostup   k   |lementam   fajlowoj
  peremennoj.

   PROCEDURE SEEK(VAR F:RANFIL; VAR DATA:USERTYPE;
                  N:INTEGER)

       procedura "SEEK" wozwra}aet N-yj |lement fajla "F" w
  peremennoj "DATA". ustanawliwaetsq EOF(F), esli ukazannyj
  |lement ne su}estwuet.

