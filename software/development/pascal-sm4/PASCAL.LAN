  <spisok polej>::=<ob}aq ~astx>!
                   <ob}aq ~astx>;<wariantnaq ~astx>!
                   <wariantnaq ~astx>
  <ob}aq ~astx>::=<sekciq zapisi>(*;<sekciq zapisi>*)
  <sekciq zapisi>::=<identifikator polq>
                   (*,<identifikator polq>*):<tip>
  <wariantnaq ~astx>::=CASE<pole priznaka>:
            <identifikator tipa> OF <wariant>(*;<wariant>*)
  <wariant>::=<spisok metok wybora>:(<spisok polej>)!
              <spisok metok wybora>
  <spisok metok wybora>::=<metka wybora>(*,<metka wybora>*)
  <metka wybora>::=<konstanta bez znaka>
  <pole priznaka>::=<identifikator>

