            7. zarezerwirowannye identifikatory

  CONSTANTS (konstanty)
         ALFALENG        dlina 'ALFA' = 10
         FALSE,TRUE
         MAXINT          maksimalxnoe celoe (32767)

  TYPES (tipy)
         ALFA            ARRAY[1..10] OF CHAR
         BOOLEAN
         CHAR
         INTEGER
         REAL
