                8. translqciq wne{nih procedur

        wne{nimi nazywa`tsq procedury ili  funkcii,  kotorye
   kompiliru`tsq  i  assembliru`tsq  otdelxno  ot   osnownoj
   programmy na qzyke paskalx. komponow}ik ispolxzuetsq  dlq
   ob'edineniq  wne{nih  procedur  i  osnownoj  programmy  i
   polu~eniq programmy w formate zagruzki. sredstwa  wne{nih
   procedur pozwolq`t obleg~itx process razrabotki i otladki
   programmnogo obespe~eniq, poskolxku wnesenie izmenenij  w
   osnownu` programmu  ne  trebuet  powtornoj  kompilqcii  i
   assemblirowaniq   wne{nih   procedur.   otladka   bolx{ih
   programm su}estwenno upro}aetsq putem sozdaniq  polnostx`
   testirowannyh wne{nih procedur. w |tom slu~ae pri otladke
   osnownoj programmy ee kompiliru`t s  kl`~em  "D".  odnako
   lokalxnye   peremennye   wne{nih   procedur    stanowqtsq
   nedostupnymi otlad~iku. razmer  otlado~noj  informacii  w
   programme su}estwenno umenx{aetsq. w  otdelxnyh  slu~aqh,
   kogda  programma  o~enx  welika  po  razmeru   zanimaemoj
   operatiwnoj pamqti, edinstwennaq  wozmovnostx  prowedeniq
   otladki - ispolxzowanie wne{nih procedur, pro{ed{ih  |tap
   testirowaniq.

        drugimi  slowami,  kogda  nad  bolx{im   programmnym  
   produktom  rabotaet  neskolxko   programmistow,   polezno
   ispolxzowatx   sowmestno   razrabotannu`   i   otlavennu`
   biblioteku wne{nih procedur.

        wne{nie procedury  i  funkcii  sozda`tsq  analogi~no
   oby~nym proceduram w qzyke paskalx.  ispolxzowanie  kl`~a
   "E" pri translqcii, priwodit k ob'qwleni` wseh procedur i
   funkcij na perwom urowne wlovennosti globalxnymi.  perwye
   6 znakow w imeni  procedury  ili  funkcii  ob'qwlq`tsq  w
   ka~estwe globalxnoj to~ki whoda  (metki),  kotoraq  budet
   ispolxzowana  komponow}ikom   pri   ob'edinenii   wne{nih
   modulej   i   osnownoj   programmy.   specialxnaq   forma
   kommentariew  (*$E+*)  movet  takve  ispolxzowatxsq   dlq
   opredeleniq  procedury  w  ka~estwe  wne{nej.  programma,
   kotoraq ispolxzuet  wne{n``  proceduru,  dolvna  wkl`~atx
   zagolowok |toj procedury,  za  kotorym  sleduet  kl`~ewoe
   slowo "EXTERNAL". nado sobl`datx ostorovnostx pri zadanii
   tipow  i   porqdka   sledowaniq   parametrow   procedury,
   poskolxku  kompilqtor  li{en  wozmovnosti  proweritx  |tu
   informaci`.

        kompilqtor   ne   otwodit   mesto   dlq   razme}eniq
   peremennyh na perwom urowne  (globalxnyh).  wmesto  |togo
   kompilqtor priswaiwaet im sootwetstwu`}ie adresa  s  tem,
   ~toby  oni  sowpadali  pri   wypolnenii   s   globalxnymi
   peremennymi osnownoj programmy.  wsq  otwetstwennostx  na
   sowpadenie  opisanij  globalxnyh  peremennyh  wo  wne{nih
   procedurah   i   osnownoj   programmy   wozlagaetsq    na
   programmista.  polxzowatxsq  |toj  wozmovnostx`   sleduet
   o~enx ostorovno, poskolxku ona movet  sluvitx  isto~nikom
   razli~nyh nepredskazuemyh o{ibok (i rezulxtatow).

        naprimer:

  globalxnye peremennye (fajl GLOBAL.PAS):

       VAR                (* globalxnye peremennye *)
           I: INTEGER;
           R: REAL;
           C: CHAR;

  osnownaq programma (fajl MAIN.PAS):

       (* wne{nqq procedura *)

       PROCEDURE EXPROC(X:INTEGER); EXTERNAL;

       BEGIN              (* na~alo MAIN *)
           I:=1; R:=3.1415926; C:='X';
           EXPROC(5);     (* wyzow wne{nej procedury *)
       END.               (* konec MAIN *)

  wne{nqq procedura (fajl EXTERN.PAS):

       (*$E+*)

       PROCEDURE EXPROC(Y:INTEGER); (* wne{nqq procedura *)

       BEGIN      (* na~alo wne{nej procedury *)
          WRITELN('I= ',I:2);
          WRITELN('R= ',R);
          WRITELN('C= ',C);
          WRITELN('PROCEDURE ARGUMENT= ',Y:3);
       END;       (* konec procedury *)

        nive  predstawlena  posledowatelxnostx  komand   dlq
   wypolneniq programmy:

          .R PASCAL
          *MAIN=GLOBAL,MAIN
          .R PASCAL
          *EXTERN=GLOBAL,EXTERN
          .R MACRO
          *MAIN=MAIN
          *EXTERN=EXTERN
          *^C
          .R LINK
          *PROG=MAIN,EXTERN,PASCAL
          *^C
          .R PROG

    9. osobennosti wypolneniq programmy na qzyke paskalx

        dlq togo, ~toby |ffektiwno ispolxzowatx  wstawki  na
   makroassemblere  w  programme  na  qzyke   paskalx/rafos,
   neobhodimo ponimatx nekotorye osobennosti ego realizacii.
   naibolee  wavnye  detali   budut   opisany   nive,   hotq
   rekomenduetsq (i |to qwlqetsq wesxma  poleznym)  zanqtxsq
   izu~eniem  teksta  na  assemblere,   kotoryj   generiruet
   kompilqtor paskalx/rafos.

        pri  wypolnenii  programma  na  qzyke  paskalx/rafos
   ispolxzuet dwe oblasti dannyh: globalxnaq oblastx i stek.
   w   globalxnoj   oblasti   sodervatsq   wse   peremennye,
   opredelennye  na  urowne  0,  t.e.  w  na~ale  programmy.
   oblastx  steka  ispolxzuetsq   dlq   hraneniq   lokalxnyh
   peremennyh dlq procedur  i  adresow  pereda~i  (wozwrata)
   uprawleniq. pqtyj registr R5 wsegda sodervit adres na~ala
   globalxnoj oblasti, a registr {estoj  (SP)  ukazywaet  na
   na~alo programmnogo steka. sodervimoe |tih  registrow  ne
   dolvno menqtxsq wo fragmente na  assemblere  (ili  dolvno
   sohranqtxsq, a zatem wosstanawliwatxsq).

        pri wyzowe procedury ispolnq`}aq sistema sohranqet w
   steke  adres  wozwrata  i  otwodit  w  steke  mesto   dlq
   parametrow i lokalxnyh peremennyh. kavdyj o~erednoj w  globalxnyh  peremennyh  wo  wne{nih
   procedurah   i   osnownoj   programmy   wozlagaetsq    na
   programmista.  polxzowatxsq  |toj  wozmovnostx`   sleduet
   o~enx ostorovno, poskolxku ona movet  sluvitx  isto~nikom
   razli~nyh nepredskazuemyh o{ibok (i rezulxtatow).

        naprimer:

  globalxnye peremennye (fajl GLOBAL.PAS):

       VAR                (* globalxnye peremennye *)
           I: INTEGER;
           R: REAL;
           C: CHAR;

  osnownaq programma (fajl MAIN.PAS):

       (* wne{nqq procedura *)

       PROCEDURE EXPROC(X:INTEGER); EXTERNAL;

       BEGIN              (* na~alo MAIN *)
           I:=1; R:=3.1415926; C:='X';
           EXPROC(5);     (* wyzow wne{nej procedury *)
       END.               (* konec MAIN *)

  wne{nqq procedura (fajl EXTERN.PAS):

       (*$E+*)

       PROCEDURE EXPROC(Y:INTEGER); (* wne{nqq procedura *)

       BEGIN      (* na~alo wne{nej procedury *)
          WRITELN('I= ',I:2);
          WRITELN('R= ',R);
        eku}ego ukazatelq  steka  -  SP.  dostup  k
   globalxnym peremennym osu}estwlqetsq indeksaciej registra
   R5.   dostup    k    promevuto~noj    peremennoj    movet
   osu}estwlqtxsq putem "dwiveniq" po steku s ispolxzowaniem
   stati~eskih ukazatelej do teh por, poka ne budet  najdena
   trebuemaq   oblastx   steka.   posle   |togo   indeksaciq
   osu}estwlqetsq otnositelxno  najdennoj  bazy.  dlq  togo,
   ~toby sdelatx  dostup  k  peremennym  bolee  prostym  dlq
   programmista na  makroassemblere,  kompilqtor  opredelqet
   imq   peremennoj   w   ka~estwe   sme}eniq   otnositelxno
   sootwetstwu`}ego ukazatelq (R5 ili SP).

        analogi~no,  to~ki  whoda  w  procedury  i   funkcii
   kompilqtor  zamenqet  na   odnoimennye   metki.   sleduet
   pomnitx,  ~to  kompilqtor   ne   prowerqet   prawilxnostx
   obra}enij k peremennym wo fragmentah na makroassemblere.

        primer:

          FUNCTION SWAPBYTES (I:INTEGER):INTEGER;
          BEGIN
                  (*$C
                          SWAB    I(SP)
                  *)
                  SWAPBYTES := I;
          END;

        esli   neobhodimo   ws`   proceduru   napisatx    na
   makroassemblere,  to  |to   movno   osu}estwitx,   prosto
   zakl`~iw  wesx  fragment  w  zagolowok  procedury,   t.e.
   ukazatx   na~alo   i   konec   procedury   po    prawilam
   paskalx/rafos. w tele procedury fragmenty  na  paskale  i
   makroassemblere mogut ~eredowatxsq, naprimer:

          PROCEDURE EXAMPLE;
          BEGIN
             (*$C
                     ;fragment na makroassemblere
             *)
        WRITE (' tekst soob}eniq');(* fragment na paskale *)
             (*$C
                     ;e}e fragment na makroassemblere
             *)
          END;

        p_r_i_m_e_~_a_n_i_e. sleduet  pomnitx,  ~to  funkcii
   sohranq`t    sodervimoe    registrow    R0-R4    (wkl`~aq
   registry-akkumulqtory processora s plawa`}ej zapqtoj),  a
   procedury - ne sohranq`t.
                     10. programma PASIMP

        programma  PASIMP  napisana  na  qzyke   paskalx   i
   prednazna~ena  dlq   wypolnenie   nekotoroj   optimizacii
   programm, sozdawaemyh kompilqtorom paskalx w operacionnoj
   sisteme rafos.

        kak   ukazywalosx   wy{e,   kompilqtor   transliruet
   programmu  s  qzyka  paskalx  na   qzyk   makroassembler.
   programma  PASIMP   obrabatywaet   tekst   programmy   na
   makroassemblere, wypolnqet otdelxnye widy  optimizacii  i
   sozdaet  bolee  |ffektiwnu`  programmu  tove   na   qzyke
   makroassembler.

        optimizacii podwerga`tsq instrukcii perehodow  (JMP,
   BR i t.p.). PASIMP wypolnqet zamenu instrukcii JMP na BR,
   esli |to wozmovno. pri |tom |konomitsq  1  slowo  pamqti.
   naprimer:

                  JMP     L20
   zamenqetsq na:
                  BR      L20

        w nekotoryh slu~aqh wypolnq`tsq bolee  slovnye  widy
   optimizacii:

                  BGT     L30
                  JMP     L50
          L30:    ...
   zamenqetsq na:
                  BLE     L50

   w |tom slu~ae |konomitsq 2 slowa pamqti.

        10.1. wyzow i zagruzka

        wyzow  programmy  PASIMP  osu}estwlqetsq   komandami
   monitora R ili RUN. posle zagruzki programma  zapra{iwaet
   imq fajla, w kotorom nahoditsq tekst  programmy,  kotoru`
   nuvno  optimizirowatx.  posle  |togo  PASIMP  zapra{iwaet
   specifikaci` wyhodnogo fajla dlq optimizirowannoj  wersii
   programmy.

        posle  wwoda  specifikacij  fajlow  PASIMP  na~inaet
   rabotatx.  w  konce  PASIMP  raspe~atywaet  statistiku  o
   processe  optimizacii,  t.e.  ~islo  slow,   na   kotoroe
   sokratilsq  razmer  programmy,  i  procentnoe  umenx{enie
   razmera programmy.

        primer:

                     .R PASIMP
                     INPUT FILE?  DK:PROG.MAC
                     OUTPUT FILE? DK:PROG1.MAC
                     IMPROVEMENT    50 WORDS   8.7%
                     .

           p_r_i_m_e_~_a_n_i_e. po  umol~ani`  tip  whodnogo  i
      wyhodnogo fajlow "MAC".

           programma   PASIMP    movet    ispolxzowatxsq    dlq
      optimizacii kak polnyh programm na qzyke paskalx,  tak  i
      otdelxnyh ~astej, kotorye oformleny po  prawilam  wne{nih
      procedur.

           tekst  programmy  na   makroassemblere   ne   dolven
      sodervatx  makrokomand.  registry   dolvny   obozna~atxsq
      tolxko kak %0, %1, ..., %6, %7. w tekste programmy  movno
      ispolxzowatx kommentarii.

           procedura   optimizacii   wypolnqetsq   srawnitelxno
      medlenno. po|tomu optimizirowatx programmu sleduet tolxko
      posle togo, kak ona polnostx` otlavena.

           10.2. soob}eniq programmy PASIMP

           nive priwodqtsq teksty soob}enij, wydawaemyh PASIMP,
      s poqsneniqmi.

      NO <> IN LINE
      NNNN  LINE
             - w stroke s nomerom "NNNN" otsutstwu`t skobki "<"
               i ">".

      ERROR AT BRJMP NODE  NNNN
             - w stroke s  nomerom  "NNNN"  obnaruvena  o{ibka,
               wozmovno swqzannaq s ispolxzowaniem kl`~a "C"  i
               wstawlennym w  tekst  na  paskale  fragmenta  na
               makroassemblere.

      ERROR AT JMP NODE  NNNN
             - w stroke s  nomerom  "NNNN"  obnaruvena  o{ibka,
               wozmovno swqzannaq s ispolxzowaniem kl`~a "C"  i
               wstawlennym w  tekst  na  paskale  fragmenta  na
               makroassemblere.

   11.osobennosti raboty w awtonomnyh sistemah.

     11.1. nabor programm dlq raboty bez operacionnoj sistemy

    dlq sozdaniq programm, rabota`}ih bez operacionnoj sistemy 
neobhodimo u~itywatx sledu`}ie ograni~eniq:
    - nedopustimo  ispolxzowanie operatora  DISPOSE i operacij
      nad mnovestwami;
    - procedury READ/WRITE movno ispolxzowatx tolxko dlq wwoda/
      wywoda w standartnye fajly INPUT i OUTPUT (t.e. na termi-
      nal) bez qwnogo ukazaniq ih imen.  pri  |tom  polxzowatelx
      dolven  sam napisatx sistemno-zawisimyj modulx  wwoda/
      wywoda.

    nive predlagaetsq nabor programm dlq organizacii formatnogo
wwoda/wywoda na standartnyj terminal.


PROGRAM IO;
[$E+,T-,A-]
CONST
  STRLEN=132;
TYPE
  STRING=ARRAY[1..STRLEN] OF CHAR;
(*-------------------------------------------------------------------------*)
[$C $B0::
	MOV	(6), -(6)	; mesto w steke pod simwol
	MOV	(6), -(6)	; i pod status
	MOV	-2(5), 2(6)	; izwle~em ukazatelx slowa sostoqniq kanala
	ADD	#2, 2(6)	; ukazatelx na slowo sostoqniq fajla
]
FUNCTION READCH(VAR STATUS: INTEGER): CHAR;
CONST
  EOF= 100000B;
  EOLN= 40000B;
VAR
  CH: CHAR;
BEGIN
  IF (STATUS AND EOLN) <> 0 THEN
  BEGIN
    STATUS:= 0;    CH:=' ';
  END ELSE
  BEGIN
    [$C
      MOV	%0, -(6)
      EMT	^O<340>
      MOV	%0, CH+2(6)
      MOV	(6)+, %0		; ~tenie simwola RT11
    ]
    IF CH = CHR(15B) THEN
             CH:=READCH(STATUS)
    ELSE BEGIN
      IF CH =CHR(12B) THEN
      BEGIN
	STATUS:= STATUS OR EOLN; CH:=' ';
      END;
    END;
  END;
  READCH:=CH;
END;
(*-------------------------------------------------------------------------*)
[$C $B12 :: ]
[ ~tenie stroki]
PROCEDURE READS( VAR LINE: STRING; 		[ stroka dlq ~teniq ]
                     LEN: INTEGER);		[ MAX koli~estwo simolow ]
VAR
  I: INTEGER;	[ s~et~ik simwolow w stroke ]
BEGIN
  I:= 1;
  WHILE (NOT EOLN) AND (I <= LEN) DO
  BEGIN
    READ(LINE[I]);
    I:=I+1
  END;
END;
(*-------------------------------------------------------------------------*)
[$C  $B16:: ]
PROCEDURE READLN;
VAR
  CH: CHAR;
BEGIN
  WHILE NOT EOLN DO READ(CH);
  READ(CH);		[ SBROSITX EOF ?]
END;
(*-------------------------------------------------------------------------*)
[ ~tenie celogo ]
[$C
$B4::	 MOV	(6), -(6)	; mesto dlq rezulxtata
]
FUNCTION READI: INTEGER;
VAR
  SUM: INTEGER;
  CH: CHAR;
BEGIN
  SUM:=0;
  REPEAT READ(CH) UNTIL CH <> ' ';
  WHILE (CH >= '0') AND (CH <= '9') DO
  BEGIN
    SUM:=SUM*10-ORD('0')+ORD(CH);
    READ(CH);
  END;
  READI:= SUM;
END;
(*-------------------------------------------------------------------------*)
FUNCTION TEN(I:INTEGER):REAL; [procedura wozwra}aet 10**I]
VAR
  P: ARRAY[1..5] OF REAL;
  NXT: INTEGER;
  MULT: REAL;
BEGIN
  P[1] := 1.0E1;
  P[2] := 1.0E2;
  P[3] := 1.0E4;
  P[4] := 1.0E8;
  P[5] := 1.0E16;
  MULT:=1.0;
  NXT:=1;
  WHILE I > 0 DO BEGIN
    IF ODD(I) THEN MULT:=MULT * P[NXT];
    NXT:=NXT+1;
    I:=I DIV 2;
  END;
  TEN:=MULT;
END;
(*-------------------------------------------------------------------------*)
[$C
$B8::	MOV	(6), -(6)	; mesto dlq rezulxtata
	MOV	(6), -(6) ]
[ ~tenie plawa`}ego ]
FUNCTION READF: REAL;
VAR
  RESULT: REAL;
  DW: INTEGER;
  CH: CHAR;
BEGIN
  RESULT:= 0.0;
  DW:=0;
  REPEAT READ(CH) UNTIL CH <> ' ';
  WHILE (CH >= '0') AND (CH <= '9') DO
  BEGIN
    RESULT:=RESULT*10.0+(ORD(CH)-ORD('0'));
    READ(CH);
  END;
  IF CH = '.' THEN
  BEGIN
    READ(CH);  
    WHILE (CH >= '0') AND (CH <= '9') DO
    BEGIN
      RESULT:=RESULT*10.0+(ORD(CH)-ORD('0'));
      DW:=DW+1;
      READ(CH);
    END;
    RESULT:=RESULT/TEN(DW);
  END;
  READF:=RESULT;
END;
(*-------------------------------------------------------------------------*)
(* wywod odnogo simwola w sisteme rt11 *)
(* dlq rezidentnoj ispolnq`}ej sistemy dolven bytx zamenen *)

PROCEDURE OUTC(CH: CHAR);
BEGIN
  (*$C
	MOVB	CH(6), %0	;polovili parametr procedury na %0
	EMT	^O<341>		;i wyweli ego
	BCS	.-2		; TTYOUT
   *)
END;
(*-------------------------------------------------------------------------*)
(* PEREHOD NA NOWU@ STROKU*)
(*$C $B36:: *)
PROCEDURE WRILN;
BEGIN
  OUTC(CHR(15B));	(* wk*)
  OUTC(CHR(12B));	(*  ps *)
END;
[-------------------------------------------------------------------------]
[ wywod simwola w pole ]
(*$C $B20:: *)
PROCEDURE WRITEC(CH: CHAR;	    [ simwol dlq pe~ati	]
		 FLDLEN: INTEGER);  [ dlina polq pe~ati ]
VAR
  CHRCNT: INTEGER;		    [ s~et~ik simwolow	]
BEGIN
  IF ORD(CH) <> 0 THEN FLDLEN:=FLDLEN-1;[]
  FOR CHRCNT:=1 TO FLDLEN DO OUTC(' ');
  IF ORD(CH) <> 0 THEN OUTC(CH);
END;
(*-------------------------------------------------------------------------*)
(* pe~atx stroki w pole *)
(*$C $B32:: *)
PROCEDURE WRITES(VAR STR: STRING;  (* stroka dlq pe~ati 		   *)
		     STRLEN,	   (* dejstwitelxnoe kol-wo simwolow w str *)
		     FLDLEN:	   (* dlina pole pe~ati 		   *)
				 INTEGER);
VAR 
  CHRCNT: INTEGER;		   (* s~et~ik simwolow pri wywode 	   *)
  MAXLEN: INTEGER;		   (* dopustimaq dlina stroki		   *)
BEGIN
  FOR CHRCNT:=1 TO FLDLEN-STRLEN DO OUTC(' ');
  MAXLEN:=STRLEN;
  IF MAXLEN > FLDLEN THEN MAXLEN :=FLDLEN;
  FOR CHRCNT:=1 TO MAXLEN DO OUTC(STR[CHRCNT]);
END;
(*-------------------------------------------------------------------------*)
[ pe~atx celogo ~isla w zadannom formate ]
[$C $B24:: ]
PROCEDURE WRITEI(DIGIT,			[ ~islo dlq pe~ati ]
		 FLD:  INTEGER);	[ MAX ~islo cifr      ]
VAR
  DIVID: ARRAY[1..5] OF INTEGER;	[ massiw delitelej ]
  I,COUNT: INTEGER;	
  FIRST: BOOLEAN;			[ flag perwoj cifry]
  SIGN: BOOLEAN;			[ flag znaka	   ]
BEGIN
  DIVID[5]:=10000;
  DIVID[4]:= 1000;
  DIVID[3]:=  100;
  DIVID[2]:=   10;			[ inicializiruem  ]
  DIVID[1]:=    1;			[ massiw delitelej]
  FIRST:=TRUE;				[ i flag perwoj cifry ]
  IF DIGIT < 0 THEN
  BEGIN
    DIGIT:=-DIGIT;
    FLD:=FLD-1;				[ mesto pod znak     ]
    SIGN:=TRUE;
  END ELSE
    SIGN:=FALSE;			[ prowerim znak	     ]
  IF DIGIT <> 0 THEN
    FOR I:=5 DOWNTO 1 DO		[ cikl wywoda ~isla  ]
    BEGIN
      COUNT:=0;
      WHILE DIGIT >= DIVID[I] DO
      BEGIN
	DIGIT:=DIGIT-DIVID[I];
	COUNT:=COUNT+1
      END;
      IF  FIRST AND (COUNT > 0) THEN
      BEGIN
	FIRST:=FALSE;
	WRITE('':FLD-I);		[ wywod wedu}ih probelow ]
	IF SIGN THEN WRITE('-');
      END;
      IF (NOT FIRST) THEN WRITE(CHR(COUNT+ORD('0')));
    END [ FOR ]
  ELSE WRITE('0':FLD);
END; [WRITEI]
(*-------------------------------------------------------------------------*)
[ pe~atx plawa`}ego ~isla w zadannom formate ]
[$C $B28:: ]
PROCEDURE WRITEF(DIGIT: REAL;			[ ~islo dlq pe~ati ]
		 FLD,				[ pole		   ]
		 FLD1: INTEGER);		[ kol-wo znakow posle zap. ]
TYPE
  HAOS=RECORD 
       CASE INTEGER OF
         1:( INT: ARRAY [1..2] OF INTEGER);
         2: (FLOAT: REAL)
       END; [ CASE ]
VAR
  DIGCOPY:    HAOS;
  EXP,I,TEMP: INTEGER;
  SIGN: BOOLEAN;
BEGIN
  IF FLD1 > 0 THEN FLD:=FLD-1;		[ poziciq pod desqti~nu` to~ku ]
  IF DIGIT < 0.0 THEN
  BEGIN
    SIGN:=TRUE;
    DIGIT:=-DIGIT;
    FLD:=FLD-1;
  END ELSE
    SIGN:=FALSE;
[-----------------------------------]
  WITH DIGCOPY DO
  BEGIN					[ wydelim |ksponentu	]
    FLOAT:=DIGIT;
    EXP:=TRUNC((( INT[1] AND (NOT 100177B)) DIV 128 - 200B) * 0.30103);

    IF EXP > 0	THEN			[ denormalizaciq	]
    BEGIN
      FLOAT:= FLOAT/TEN(EXP);
      IF TRUNC(FLOAT)= 0 THEN
      BEGIN
	FLOAT:=FLOAT*10.;
	EXP:=EXP-1
      END;
    END ELSE EXP := 0;
    IF FLD1 < 0 THEN FLD1:= 0;
    FLOAT:=FLOAT+0.5/TEN(EXP+FLD1);	[ okruglenie		]
[ 1 <= FLOAT <= 10 ]
    EXP:=EXP+1;	 			[ kol - wo znakow do zapqtoj	]
    WRITE('':FLD-EXP-FLD1);		[ wedu}ie probely	  	]
    IF SIGN THEN WRITE('-');
    FOR I:=1 TO EXP DO 		[ wywodim znaki do zapqtoj	]
    BEGIN
      TEMP:=TRUNC(FLOAT);
      WRITE(CHR(TEMP+ORD('0'))); 
      FLOAT:=(FLOAT-TEMP)*10;
    END;
    IF FLD1 > 0 THEN WRITE('.');
    FOR I:=1 TO FLD1 DO
    BEGIN
      TEMP:=TRUNC(FLOAT);
      WRITE(CHR(TEMP+ORD('0'))); 
      FLOAT:=(FLOAT-TEMP)*10;
    END;
   END; [ WITH ]
END;


                                            prilovenie 1

		komandy paskalx - otlad~ika  V1.2H


        B                   udalitx teku}u` to~ku ostanowa
        B(BLOCK,STATEMENT)  ustanowitx to~ku ostanowa, (imq, nomer stroki)

        C                   prodolvitx wypolnenie posle ostanowa
        C(N)                propustitx to~ku ostanowa N raz

        D                   otobrazitx to~ki ostanowa, slevenie, metki

        G                   wypolnqtx programmu s na~ala
	G(N)                wypolnqtx programmu s metki N=0..8

        H                   otobrazitx spisok wyzowow i poslednie op.

        K                   udalitx wse to~ki ostanowa
        K(BLOCK, STATEMENT) udalitx opredelennu` to~ku ostanowa

        L(N)                pometitx teku}ij operator (N=0..8)

        P                   wypolnitx operator teku}ego urownq
        P(N)                wypolnitx N operatorow teku}ego urownq
 
        S                   wypolnitx odin operator ({ag)
        S(N)                wypolnitx N operatorow

        T(TRUE/FALSE)       razre{itx/zapretitx trassirowku

	V                   otmenitx slevenie
        V(VARIABLE)         ustanowitx slevenie za peremennoj

        W(NAME1,NAME2...)   raspe~atatx peremennu`, konstantu, ukazatelx.
                            movet ispolxzowatxsq paskalewskaq notaciq 
                            zadaniq formata, ~islo, ukazannoe wmesto imeni-
                            absol`tnyj adres, B posle konstanty - OCT.

        VARIABLE := VALUE   priswoitx peremennoj zna~enie




␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀