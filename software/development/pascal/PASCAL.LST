  512 βακτ χ ζακμε, μιβο - 1, εσμι ζακμ ξε ξακδεξ. σμεδυετ  υώεστψ,
  ώτο εσμι  ότοτ  παςανετς  ξε  ισπομψϊοχαξ,  το  οτσυτστχιε  ζακμα
  πςιχεδετ λ ζαταμψξοκ οϋιβλε πςοηςαννω.


  PROCEDURE REWRITE(F:FILE; NAME,DEFEXT:STRING;
                    VAR LEN:INTEGER)

       πςογεδυςα  "REWRITE"   σοϊδαετ   ξοχωκ   ζακμ   ξα   χξεϋξεν

                               - 37 -




  υστςοκστχε. παςανετςω "NAME" ι  "DEFEXT"  ινεΰτ  το  φε  ϊξαώεξιε
  (σνωσμ), ώτο ι δμρ πςογεδυςω "RESET".  παςανετς  "LEN"  υλαϊωχαετ
  ςαϊνες σοϊδαχαενοηο ζακμα χ βμολαθ πο 512 βακτ.

       πςινες:

         VAR NAME: ARRAY[1..20] OF CHAR;
             INF,OUTF: TEXT;
             (* οπςεδεμεξο χ σιστενε λαλ "FILE OF CHAR *)
             LEN: INTEGER;
         BEGIN
             (* σχρϊατψ OUTF σ υστςοκστχον πεώατι *)
             REWRITE(OUTF,'LP:');
             REPEAT
                 WRITE('FILENAME: ');
                 (* ϊαπςοσιτψ ινρ ζακμα σ τεςνιξαμα *)
                 READLN(NAME);
                 (*σχρϊατψ INF σ συύεστχυΰύιν ζακμον *)
                 RESET(INF,NAME,'PAS',LEN)
             (* ποχτοςρτψ πολα ζακμ ξε βυδετ οτλςωτ *)
             UNTIL LEN<>-1;
         END.



