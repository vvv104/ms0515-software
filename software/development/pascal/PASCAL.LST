               [ELSE <οπεςατος>] END
  <αμψτεςξατιχα>::=<σπισολ νετολ χωβοςα>:<οπεςατος>
  <σπισολ νετολ χωβοςα>::=<νετλα χωβοςα>(*,<νετλα χωβοςα>*)

