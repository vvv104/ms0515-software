  FUNCTION SQRT (X : REAL) : REAL;
    VAR X0,X1 : REAL;
  BEGIN X1:=X; (*X > 1, νετοδ ξψΰτοξα*)
    REPEAT X0:=X1; X1:=(X0 + X/X0) * 0.5
    UNTIL ABS(X1 - X0) < EPS*X1;
    SQRT:=X0
  END








                               - 43 -




  FUNCTION MAX(A : VECTOR; N : INTEGER) : REAL;
         VAR X : REAL; I : INTEGER;
  BEGIN X :=A[1];
         FOR I :=2 TO N DO
         BEGIN (* X=MAX(A[1]...A[I-1]) *)
         IF X<A[I] THEN X := A[I]
         END;
         (* X = MAX(A[1]..A[N]) *)
         MAX:=X
  END

  FUNCTION στεπεξψ (X:REAL; Y:INTEGER) :REAL; (* Y>=0 *)
         VAR B,Z ; REAL;I : INTEGER;
  BEGIN B =: X; Z := 1; I := Y;
         WHILE I <> 0 DO
         BEGIN (* Z * B**I = X**Y *)
         IF ODD(I) THEN Z := Z*B;
         I := I DIV 2; B := SQR(B)
  END (* Z = X**Y *);
  στεπεξψ := Z
  END



